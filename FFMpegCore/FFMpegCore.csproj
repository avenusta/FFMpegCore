<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Avenusta.FFMpegCore</PackageId>
    <Description>Fork of FFMpegCore with additional features</Description>
    <Version>5.10.0</Version>
    <PackageOutputPath>../nupkg</PackageOutputPath>
    <PackageReleaseNotes>
      - Prevent thread-pool starvation during binary checks and codec, format, and pixel-format discovery.
      - Report progress at low log levels and avoid retaining per-run log-level settings.
      - Support disabling subtitle and data streams.
      - Fix relative demux-concat paths, tee output escaping and overwrite handling, and codec names in file-extension mappings.
      - Propagate failures and cancellation from asynchronous frame and packet probing.
      - Update Instances to 3.1.0 and expand regression coverage while preserving fork APIs and executable-path overrides.
    </PackageReleaseNotes>
    <PackageTags>ffmpeg ffprobe convert video audio mediafile resize analyze muxing</PackageTags>
    <Authors>Malte Rosenbjerg, Vlad Jerca, Max Bagryantsev</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Instances" Version="3.1.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.10"/>
  </ItemGroup>

</Project>
