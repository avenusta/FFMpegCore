<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Avenusta.FFMpegCore</PackageId>
    <Description>Fork of FFMpegCore with additional features</Description>
    <Version>5.11.0</Version>
    <PackageOutputPath>../nupkg</PackageOutputPath>
    <PackageReleaseNotes>
      - Expose codec extradata (for example avcC, hvcC, av1C) on video and audio streams as `MediaStream.Extradata` when probing with `-show_data`.
      - Add `MediaAnalysisUtils.ParseHexDump` for ffprobe hex dumps.
    </PackageReleaseNotes>
    <PackageTags>ffmpeg ffprobe convert video audio mediafile resize analyze muxing</PackageTags>
    <Authors>Malte Rosenbjerg, Vlad Jerca, Max Bagryantsev</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Instances" Version="3.1.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.10"/>
  </ItemGroup>

</Project>
